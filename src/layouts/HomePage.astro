---
import type { Lang } from '../i18n/routes';
import { UI } from '../i18n/ui';
import type { HomeCopy } from '../copy/types';
import { businessNode, faqNode, graph, websiteNode } from '../lib/schema';

import Base from './Base.astro';
import Hero from '../components/Hero.astro';
import Band from '../components/Band.astro';
import Plate from '../components/Plate.astro';
import PlateGrid from '../components/PlateGrid.astro';
import SpecTable from '../components/SpecTable.astro';
import StepList from '../components/StepList.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceCards from '../components/ServiceCards.astro';
import AreaServed from '../components/AreaServed.astro';
import DiagSeccion from '../components/diagrams/DiagSeccion.astro';
import DiagPlegado from '../components/diagrams/DiagPlegado.astro';

interface Props { lang: Lang; copy: HomeCopy }
const { lang, copy } = Astro.props;
const t = UI[lang];

const tones = ['white', 'paper', 'alt'] as const;
let figNo = 1; // FIG 01 is the hero plate
---
<Base
  pageKey="home"
  lang={lang}
  title={copy.title}
  description={copy.description}
  jsonLd={graph([businessNode(lang), websiteNode(lang), faqNode(copy.faq)])}
  waMessage={copy.waMessage}
>
  <Hero
    lang={lang}
    eyebrow={copy.eyebrow}
    title={copy.h1}
    lede={copy.lede}
    photoId="cubierta-panel-preaislado"
  />

  <Band tone="paper">
    <h2>{copy.blocks[0].h2}</h2>
    <div class="after prose">
      {copy.blocks[0].p?.map((para) => <p>{para}</p>)}
    </div>
    <div class="after"><ServiceCards lang={lang} /></div>
  </Band>

  {copy.blocks.slice(1).map((block, i) => {
    const photos = block.photos ?? [];
    const start = figNo + 1;
    figNo += photos.length;
    return (
      <Band tone={tones[i % tones.length]}>
        <div class="blk">
          <div class="prose">
            <h2>{block.h2}</h2>
            {block.p?.map((para) => <p>{para}</p>)}
            {block.bullets && <ul>{block.bullets.map((b) => <li>{b}</li>)}</ul>}
          </div>
          {block.diagram === 'seccion' && <div class="fig"><DiagSeccion lang={lang} /></div>}
          {block.diagram === 'plegado' && <div class="fig"><DiagPlegado lang={lang} /></div>}
          {photos.length === 1 && (
            <div class="one"><Plate id={photos[0]} lang={lang} fig={start} /></div>
          )}
          {photos.length > 1 && (
            <div class="many"><PlateGrid ids={photos} lang={lang} startFig={start} /></div>
          )}
        </div>
      </Band>
    );
  })}

  <Band tone="white">
    <h2>{t.specHeading}</h2>
    <div class="after">
      <SpecTable caption={copy.spec.caption} head={copy.spec.head} rows={copy.spec.rows} />
    </div>
  </Band>

  <Band tone="paper">
    <h2>{copy.stepsHeading}</h2>
    <div class="after"><StepList steps={copy.steps} /></div>
  </Band>

  <Band tone="alt">
    <AreaServed lang={lang} />
  </Band>

  <Band tone="white">
    <h2>{t.faqHeading}</h2>
    <div class="after"><Faq items={copy.faq} /></div>
  </Band>

  <CtaBand lang={lang} heading={copy.ctaHeading} body={copy.ctaBody} message={copy.waMessage} />
</Base>

<style>
  .blk { display: grid; gap: var(--s6); }
  .fig { max-width: 660px; }
  .one { max-width: var(--photo-max); }
  .after { margin-top: var(--s6); }
  @media (min-width: 1000px) {
    .blk:has(.one) { grid-template-columns: 1fr var(--photo-max); align-items: start; gap: var(--s8); }
  }
</style>
