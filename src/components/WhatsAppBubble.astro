---
import { BUSINESS } from '../config/site';
import { waHref } from '../lib/contact';
import { UI } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang; message?: string }
const { lang, message } = Astro.props;
const t = UI[lang];
const label = t.whatsappAria + ' ' + BUSINESS.phone.display;
---
<a class="wa" href={waHref(message)} target="_blank" rel="noopener" aria-label={label}>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97s-.47-.15-.67.15-.77.96-.94 1.16-.35.22-.64.07a8.2 8.2 0 0 1-2.4-1.48 9 9 0 0 1-1.66-2.06c-.18-.3 0-.46.13-.6s.3-.35.44-.52a2 2 0 0 0 .3-.5.55.55 0 0 0 0-.52c-.08-.15-.67-1.6-.91-2.2s-.49-.5-.67-.51h-.57a1.1 1.1 0 0 0-.8.37 3.34 3.34 0 0 0-1.04 2.48 5.8 5.8 0 0 0 1.21 3.08 13.26 13.26 0 0 0 5.08 4.49c.71.3 1.26.49 1.69.63a4.06 4.06 0 0 0 1.87.12 3.06 3.06 0 0 0 2-1.41 2.48 2.48 0 0 0 .17-1.41c-.07-.13-.26-.2-.56-.35M12.05 21.8h-.02a9.8 9.8 0 0 1-4.99-1.37l-.36-.21-3.71.97 1-3.62-.24-.37A9.79 9.79 0 0 1 18.98 5.04a9.73 9.73 0 0 1 2.87 6.9 9.8 9.8 0 0 1-9.8 9.85M20.5 3.49A12.2 12.2 0 0 0 1.4 18.2L0 24l5.94-1.56a12.16 12.16 0 0 0 5.83 1.49h.01A12.19 12.19 0 0 0 20.5 3.49"/>
  </svg>
  <span class="sr-only">{t.whatsappCta}</span>
</a>

<style>
  .wa {
    position: fixed;
    right: var(--s4);
    bottom: calc(var(--callbar-h) + var(--s4));
    z-index: 40;
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--wa);
    color: #06331a;
    box-shadow: 0 2px 10px rgb(11 12 14 / 0.28);
    transition: transform 0.15s;
  }
  .wa svg { width: 28px; height: 28px; }
  .wa:hover { transform: translateY(-2px); color: #06331a; }
  @media (min-width: 768px) { .wa { bottom: var(--s5); } }
</style>
