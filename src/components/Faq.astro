---
/** Fed by the SAME array that produces the FAQPage JSON-LD, so the markup and
 *  the visible content cannot diverge. <details> needs no JavaScript. */
interface Props { items: readonly { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary>{f.q}</summary>
      <div><p>{f.a}</p></div>
    </details>
  ))}
</div>
