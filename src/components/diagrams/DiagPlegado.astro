---
/**
 * Redraw of the workshop nesting screen at infinite resolution. The photograph
 * of the real screen sits beside it; this carries the same information without
 * the glare — and without publishing the client job name that is on the real one.
 */
import type { Lang } from '../../i18n/routes';
interface Props { lang: Lang }
const { lang } = Astro.props;

const L = {
  es: {
    title: 'Despiece y anidado de piezas de conducto sobre una chapa',
    head: 'Despiece CAD/CAM',
    sheet: 'Chapa 2587 × 1495 mm',
    thick: 'Espesor 0,8 mm',
    cut: 'Recorrido de corte',
    parts: 'Desarrollos numerados',
  },
  en: {
    title: 'CAD/CAM nesting of duct flat patterns on a single sheet',
    head: 'CAD/CAM nesting',
    sheet: 'Sheet 2587 × 1495 mm',
    thick: 'Thickness 0.8 mm',
    cut: 'Cut path',
    parts: 'Numbered flat patterns',
  },
}[lang];
---
<svg class="diag" viewBox="0 0 660 400" role="img" aria-label={L.title}>
  <title>{L.title}</title>

  <rect x="30" y="26" width="600" height="292" class="f-steel" />
  <rect x="40" y="36" width="580" height="272" class="s-hair" />

  <g class="f-unit">
    <rect x="56" y="52" width="196" height="86" />
    <rect x="266" y="52" width="150" height="86" />
    <rect x="430" y="52" width="108" height="118" />
    <rect x="552" y="52" width="58" height="70" />
    <rect x="56" y="150" width="96" height="102" />
    <rect x="164" y="150" width="120" height="74" />
    <rect x="296" y="150" width="104" height="102" />
    <rect x="412" y="184" width="126" height="68" />
    <rect x="552" y="136" width="58" height="116" />
    <rect x="56" y="264" width="140" height="40" />
    <rect x="210" y="264" width="190" height="40" />
  </g>

  <g class="t-num">
    <text x="146" y="100">1C</text>
    <text x="336" y="100">7C</text>
    <text x="478" y="114">3D</text>
    <text x="574" y="92">3C</text>
    <text x="98" y="204">4C</text>
    <text x="218" y="192">4A</text>
    <text x="342" y="204">5C</text>
    <text x="468" y="222">3C</text>
    <text x="574" y="198">3D</text>
    <text x="119" y="288">2D</text>
    <text x="298" y="288">2C</text>
  </g>

  <path class="cut" d="M60 298 L250 94 L410 58 L536 164 L606 246 L300 196 L60 298" />

  <text x="30" y="18" class="t-lbl">{L.head}</text>
  <text x="630" y="18" class="t-lbl" text-anchor="end">{L.sheet}</text>
  <text x="30" y="342" class="t-lbl">{L.thick}</text>
  <text x="30" y="362" class="t-lbl">{L.parts}</text>
  <text x="630" y="362" class="t-lbl" text-anchor="end">{L.cut}</text>
  <line x1="544" y1="358" x2="584" y2="358" class="cut" />
</svg>

<style>
  .diag { width: 100%; height: auto; color: currentColor; }
  .s-hair { stroke: currentColor; stroke-width: 1; fill: none; opacity: 0.45; }
  .f-steel { fill: currentColor; fill-opacity: 0.1; stroke: currentColor; stroke-width: 1.5; }
  .f-unit { fill: currentColor; fill-opacity: 0.16; stroke: currentColor; stroke-width: 1.2; }
  .cut { stroke: var(--red-500); stroke-width: 1.5; fill: none; opacity: 0.9; }
  .t-lbl {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em;
    text-transform: uppercase; fill: currentColor; opacity: 0.72;
  }
  .t-num {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em;
    fill: currentColor; opacity: 0.85;
  }
</style>
