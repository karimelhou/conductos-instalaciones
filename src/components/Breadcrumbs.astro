---
/** Renders the visible trail from the SAME array that feeds the
 *  BreadcrumbList JSON-LD, so the two cannot diverge. */
import type { Crumb } from '../lib/schema';
import { UI } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props { crumbs: Crumb[]; lang: Lang }
const { crumbs, lang } = Astro.props;
---
<nav class="crumbs" aria-label={UI[lang].breadcrumbAria}>
  <div class="container">
    <ol>
      {crumbs.map((c, i) => (
        <li>
          {i < crumbs.length - 1
            ? <a href={c.url}>{c.name}</a>
            : <span aria-current="page">{c.name}</span>}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .crumbs {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding-block: var(--s3);
    font-family: var(--font-mono);
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .crumbs ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }
  .crumbs li + li::before { content: '/'; color: var(--steel-400); margin-right: var(--s2); }
  .crumbs a { color: var(--steel-600); text-decoration: none; }
  .crumbs a:hover { color: var(--red-600); text-decoration: underline; }
  .crumbs span { color: var(--ink-900); font-weight: 600; }
</style>
