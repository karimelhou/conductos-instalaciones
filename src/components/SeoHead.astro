---
/**
 * THE ONLY place that emits title, description, canonical, hreflang, robots,
 * Open Graph and Twitter tags. If you are adding a meta tag anywhere else,
 * add it here instead.
 */
import { SITE_URL, BUSINESS } from '../config/site';
import { type Lang, type PageKey, byKey, urlFor, LANGS } from '../i18n/routes';

interface Props {
  pageKey: PageKey;
  lang: Lang;
  title: string;
  description: string;
  preloadImage?: { href: string; srcset?: string; sizes?: string };
}

const { pageKey, lang, title, description, preloadImage } = Astro.props;

const row = byKey(pageKey);
const noindex = row.noindex;
const canonical = urlFor(pageKey, lang);
const ogImage = `${SITE_URL}/og/${pageKey}-${lang}.png`;
const locale = lang === 'es' ? 'es_ES' : 'en_GB';
const altLocale = lang === 'es' ? 'en_GB' : 'es_ES';
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{/* A noindexed page must carry NO hreflang: it would poison the whole cluster. */}
{noindex ? (
  <meta name="robots" content="noindex,follow" />
) : (
  <>
    {LANGS.map((l) => (
      <link rel="alternate" hreflang={l} href={urlFor(pageKey, l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={urlFor(pageKey, 'es')} />
  </>
)}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={BUSINESS.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={BUSINESS.name} />
<meta property="og:locale" content={locale} />
<meta property="og:locale:alternate" content={altLocale} />

{/* No twitter:site — the client has no account, and a dangling handle is worse than none. */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#0b0c0e" />
<meta name="format-detection" content="telephone=yes" />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<link
  rel="preload"
  href="/fonts/barlow-condensed-700-latin.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
{preloadImage && (
  <link
    rel="preload"
    as="image"
    href={preloadImage.href}
    imagesrcset={preloadImage.srcset}
    imagesizes={preloadImage.sizes}
  />
)}
