---
interface Props {
  caption?: string;
  head: [string, string];
  rows: readonly (readonly [string, string])[];
}
const { caption, head, rows } = Astro.props;
---
<div class="table-scroll">
  <table class="spec">
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr><th scope="col">{head[0]}</th><th scope="col">{head[1]}</th></tr>
    </thead>
    <tbody>
      {rows.map(([k, v]) => (
        <tr><th scope="row">{k}</th><td>{v}</td></tr>
      ))}
    </tbody>
  </table>
</div>
